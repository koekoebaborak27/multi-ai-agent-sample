# ── データベース ──
# ローカルはDocker上のPostgreSQL。本番はSupabaseの接続文字列に差し替える。
DATABASE_URL=postgresql://app:password@localhost:5432/app_db

# ── 認証 (Auth.js v5) ──
AUTH_SECRET=change-me-to-a-long-random-string   # JWT署名。`openssl rand -base64 32` 等で生成
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true                            # 本番はCloud Run(リバースプロキシ)背後のため必須

# ── Microsoft Entra ID (OIDC・任意) ──
# 3つとも設定した場合のみ Entra ID ログインが有効になる。未設定なら Credentials(ID/PW) のみで動作する。
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0

# ── アプリ設定 ──
MAX_ATTEMPTS=20                                 # ログイン失敗ロックのしきい値
PAGE_SIZE=30                                    # 一覧のデフォルトページサイズ

# ── ログ ──
LOG_LEVEL=info                                  # error/warn/info/debug
LOG_PRETTY=true                                 # ローカルのみ true（本番はJSON出力）

# ── ストレージ ──
STORAGE_TYPE=local                              # local | supabase
STORAGE_LOCAL_DIR=./uploads                     # STORAGE_TYPE=local のときの保存先（開発・検証用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── メール送信 ──
# パスワード再発行・メールアドレス変更の通知に使う。
# MAIL_TRANSPORT=console のときは実際には送らず、内容をログへ出すだけ（普段の開発はこれでよい）。
# 実際に送るときだけ smtp にして、下の SMTP_* を設定する。
# 接続先を差し替えるだけで Gmail SMTP / Amazon SES / Resend のいずれにも繋がる。
APP_BASE_URL=http://localhost:3000              # メールに載せるURLの先頭部分。本番は Cloud Run のURL
MAIL_TRANSPORT=console                          # console（ログへ出すだけ）| smtp（実際に送る）
MAIL_FROM=                                      # 送信元アドレス。Gmail SMTP の場合は SMTP_USER と同じ値にする
MAIL_FROM_NAME=サンプル契約管理システム           # 差出人の表示名
SMTP_HOST=smtp.gmail.com                        # Gmail の場合。SES は email-smtp.<region>.amazonaws.com
SMTP_PORT=587                                   # 587（STARTTLS）を使う
SMTP_USER=                                      # Gmail SMTP の場合は送信に使う Gmail アドレス
SMTP_PASSWORD=                                  # Gmail SMTP の場合はアプリパスワード16文字（空白は詰める）

# ── CSV (将来用) ──
CSV_DEFAULT_ENCODING=utf8

# ── worker の起動（本番のみ。Cloud Run Jobs として単発実行する）──
WORKER_INVOKE_MODE=none                         # none（既定・ローカル）| cloud-run-job（本番）
CLOUD_RUN_JOB_NAME=
CLOUD_RUN_JOB_REGION=us-central1
GOOGLE_CLOUD_PROJECT=

# ── 自動テスト用アカウント ──
SEED_ADMIN_LOGIN_ID=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_OPERATOR_LOGIN_ID=opeTest
SEED_OPERATOR_PASSWORD=test@123
SEED_VIEWER_LOGIN_ID=viwTest
SEED_VIEWER_PASSWORD=test@123