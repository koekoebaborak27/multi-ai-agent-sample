# ── データベース ──
# ローカルはDocker上のPostgreSQL。本番はSupabaseの接続文字列に差し替える。
DATABASE_URL=postgresql://app:password@localhost:5432/app_db

# ── 認証 (Auth.js v5) ──
AUTH_SECRET=change-me-to-a-long-random-string   # JWT署名。`openssl rand -base64 32` 等で生成
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true                            # 本番はCloud Run(リバースプロキシ)背後のため必須

# ── Microsoft Entra ID (OIDC・任意) ──
# 3つとも設定した場合のみ Entra ID ログインが有効になる。未設定なら Credentials(ID/PW) のみで動作する。
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0

# ── アプリ設定 ──
MAX_ATTEMPTS=20                                 # ログイン失敗ロックのしきい値
PAGE_SIZE=30                                    # 一覧のデフォルトページサイズ

# ── ログ ──
LOG_LEVEL=info                                  # error/warn/info/debug
LOG_PRETTY=true                                 # ローカルのみ true（本番はJSON出力）

# ── ストレージ ──
STORAGE_TYPE=local                              # local | supabase
STORAGE_LOCAL_DIR=./uploads                     # STORAGE_TYPE=local のときの保存先（開発・検証用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# ── CSV (将来用) ──
CSV_DEFAULT_ENCODING=utf8
